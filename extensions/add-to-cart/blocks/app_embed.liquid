{% comment %}
  Fly-to-Cart Pro App Embed Block
{% endcomment %}

{% assign ftc_configs_raw = shop.metafields.fly_to_cart.configurations.value %}
{% assign animation_key = '' %}
{% assign sound_key = '' %}
{% if ftc_configs_raw != blank %}
  {% assign ftc_configs = ftc_configs_raw %}
  {% for cfg in ftc_configs %}
    {% if cfg.live == true %}
      {% assign animation_key = cfg.animationKey %}
      {% assign sound_key = cfg.soundKey %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if animation_key != blank or sound_key != blank %}
<script>
  window.FlyToCartConfig = {
    animationKey: {{ animation_key | default: '' | json }},
    soundKey: {{ sound_key | default: '' | json }}
  };

  class FlyToCartPro {
    constructor(config) {
      this.config = config;
      this.audioContext = null;
      this.gsapLoaded = false;
      this.init();
    }

    init() {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js';
      script.onload = () => {
        this.gsapLoaded = true;
        this.attachListeners();
      };
      document.head.appendChild(script);
    }

    attachListeners() {
      document.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-to-cart], button[type="submit"]');
        if (btn && /add to (cart|bag)/i.test(btn.textContent)) {
          this.trigger(btn);
        }
      });
    }

    trigger(btn) {
      if (this.config.animationKey) this.playAnimation(btn);
      if (this.config.soundKey) this.playSound(this.config.soundKey);
    }

    playAnimation(btn) {
      if (!this.gsapLoaded || !window.gsap) return;
      const el = btn.closest('[data-product]') || btn;
      const clone = el.cloneNode(true);
      const rect = el.getBoundingClientRect();
      Object.assign(clone.style, {
        position: 'fixed',
        left: rect.left + 'px',
        top: rect.top + 'px',
        width: rect.width + 'px',
        height: rect.height + 'px',
        pointerEvents: 'none',
        zIndex: '9999',
        margin: '0',
      });
      document.body.appendChild(clone);

      const animations = {
        slide_in: () => gsap.to(clone, { duration: 1, x: 120, y: -120, opacity: 0, ease: 'power2.inOut', onComplete: () => clone.remove() }),
        bounce:   () => gsap.timeline().to(clone, { duration: 0.4, y: -30, ease: 'power1.out' }).to(clone, { duration: 0.3, y: 10, ease: 'bounce.out' }).to(clone, { duration: 0.3, x: 120, y: -120, opacity: 0, onComplete: () => clone.remove() }),
        flip:     () => gsap.timeline().to(clone, { duration: 0.7, rotationY: 360 }).to(clone, { duration: 0.3, x: 120, y: -120, opacity: 0, onComplete: () => clone.remove() }),
        pulse:    () => { clone.remove(); const cart = document.querySelector('[data-cart-icon], .cart-icon'); if (cart) gsap.timeline().to(cart, { duration: 0.3, scale: 1.2 }).to(cart, { duration: 0.3, scale: 1 }); },
        spiral:   () => gsap.to(clone, { duration: 1.2, x: 120, y: -120, rotationZ: 360, opacity: 0, ease: 'power2.inOut', onComplete: () => clone.remove() }),
      };

      const fn = animations[this.config.animationKey];
      if (fn) fn(); else clone.remove();
    }

    playSound(soundKey) {
      try {
        if (!this.audioContext) {
          this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        const ctx = this.audioContext;
        const now = ctx.currentTime;

        const sounds = {
          chime: () => [523, 659, 784].forEach((f, i) => { const o = ctx.createOscillator(), g = ctx.createGain(); o.connect(g); g.connect(ctx.destination); o.frequency.value = f; g.gain.setValueAtTime(0.3, now + i * 0.1); g.gain.exponentialRampToValueAtTime(0.01, now + i * 0.1 + 0.2); o.start(now + i * 0.1); o.stop(now + i * 0.1 + 0.2); }),
          whoosh: () => { const o = ctx.createOscillator(), g = ctx.createGain(); o.connect(g); g.connect(ctx.destination); o.frequency.setValueAtTime(400, now); o.frequency.exponentialRampToValueAtTime(100, now + 0.4); g.gain.setValueAtTime(0.3, now); g.gain.exponentialRampToValueAtTime(0.01, now + 0.4); o.start(now); o.stop(now + 0.4); },
          pop:    () => { const o = ctx.createOscillator(), g = ctx.createGain(); o.connect(g); g.connect(ctx.destination); o.frequency.setValueAtTime(150, now); o.frequency.exponentialRampToValueAtTime(50, now + 0.1); g.gain.setValueAtTime(0.4, now); g.gain.exponentialRampToValueAtTime(0.001, now + 0.1); o.start(now); o.stop(now + 0.1); },
          bell:   () => { const o = ctx.createOscillator(), g = ctx.createGain(); o.connect(g); g.connect(ctx.destination); o.frequency.value = 800; g.gain.setValueAtTime(0.3, now); g.gain.exponentialRampToValueAtTime(0.01, now + 0.7); o.start(now); o.stop(now + 0.7); },
          sparkle:() => [0,1,2].forEach(i => { const o = ctx.createOscillator(), g = ctx.createGain(); o.connect(g); g.connect(ctx.destination); o.frequency.value = 1000 + i * 300; g.gain.setValueAtTime(0.2, now + i * 0.15); g.gain.exponentialRampToValueAtTime(0.01, now + i * 0.15 + 0.15); o.start(now + i * 0.15); o.stop(now + i * 0.15 + 0.15); }),
        };

        const fn = sounds[soundKey];
        if (fn) fn();
      } catch (e) {
        console.error('[FlyToCartPro] Sound error:', e);
      }
    }
  }

  if (window.FlyToCartConfig.animationKey || window.FlyToCartConfig.soundKey) {
    window.flyToCartPro = new FlyToCartPro(window.FlyToCartConfig);
  }
</script>
{% endif %}

{% schema %}
{
  "name": "Fly-to-Cart Pro",
  "target": "body",
  "settings": []
}
{% endschema %}
