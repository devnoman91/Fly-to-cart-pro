{% comment %}
  Fly-to-Cart Pro App Embed Block
  Injects animation and sound effects for add-to-cart actions
{% endcomment %}

<script>
  // Fly to Cart Pro - Animation & Sound Extension
  class FlyToCartPro {
    constructor() {
      this.gsapLoaded = false;
      this.audioContext = null;
      this.soundCache = new Map();
      this.init();
    }

    init() {
      // Load GSAP library
      this.loadGSAP(() => {
        this.attachEventListeners();
      });
    }

    loadGSAP(callback) {
      const script = document.createElement('script');
      script.src = 'https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js';
      script.onload = () => {
        this.gsapLoaded = true;
        callback();
      };
      script.onerror = () => {
        console.error('[FlyToCartPro] Failed to load GSAP');
      };
      document.head.appendChild(script);
    }

    attachEventListeners() {
      // Listen for add-to-cart button clicks
      document.addEventListener('click', (e) => {
        const addToCartBtn = e.target.closest('[data-add-to-cart], button[type="submit"]');
        if (addToCartBtn && this.isAddToCartButton(addToCartBtn)) {
          this.handleAddToCart(addToCartBtn);
        }
      });

      // Listen for form submissions
      document.addEventListener('submit', (e) => {
        const form = e.target;
        if (this.isAddToCartForm(form)) {
          setTimeout(() => this.handleAddToCart(form), 100);
        }
      });
    }

    isAddToCartButton(element) {
      const text = element.textContent.toLowerCase();
      return (
        text.includes('add to cart') ||
        text.includes('add to bag') ||
        element.hasAttribute('data-add-to-cart')
      );
    }

    isAddToCartForm(form) {
      const submitButton = form.querySelector('button[type="submit"]');
      if (!submitButton) return false;
      const text = submitButton.textContent.toLowerCase();
      return text.includes('add to cart') || text.includes('add to bag');
    }

    async handleAddToCart(element) {
      try {
        const productElement = element.closest('[data-product]') || document.querySelector('[data-product]');
        if (!productElement) return;

        const productId = this.extractProductId(productElement);
        if (!productId) return;

        // Fetch animation config from server
        const config = await this.fetchAnimationConfig(productId);
        if (!config) return;

        // Play animation
        if (config.animationKey) {
          this.playAnimation(config.animationKey, productElement);
        }

        // Play sound
        if (config.soundKey) {
          this.playSound(config.soundKey, config.volume || 0.8);
        }
      } catch (error) {
        console.error('[FlyToCartPro] Error in handleAddToCart:', error);
      }
    }

    async fetchAnimationConfig(productId) {
      try {
        const response = await fetch('/api/animation-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productId }),
        });

        if (!response.ok) return null;
        return await response.json();
      } catch (error) {
        console.error('[FlyToCartPro] Failed to fetch animation config:', error);
        return null;
      }
    }

    playAnimation(animationType, productElement) {
      if (!this.gsapLoaded || !window.gsap) {
        console.warn('[FlyToCartPro] GSAP not loaded');
        return;
      }

      const clone = this.createProductClone(productElement);
      if (!clone) return;

      const animations = {
        slide_in: () => this.animateSlideIn(clone),
        bounce: () => this.animateBounce(clone),
        flip: () => this.animateFlip(clone),
        pulse: () => this.animatePulse(),
        spiral: () => this.animateSpiral(clone),
      };

      const animateFn = animations[animationType];
      if (animateFn) {
        animateFn();
      }
    }

    animateSlideIn(element) {
      gsap.to(element, {
        duration: 1,
        x: 100,
        y: -100,
        opacity: 0,
        ease: 'power2.inOut',
        onComplete: () => element.remove(),
      });
    }

    animateBounce(element) {
      gsap
        .timeline()
        .to(element, { duration: 0.4, y: -30, ease: 'power1.out' }, 0)
        .to(element, { duration: 0.3, y: 10, ease: 'bounce.out' })
        .to(element, { duration: 0.3, x: 100, y: -100, opacity: 0, onComplete: () => element.remove() });
    }

    animateFlip(element) {
      gsap
        .timeline()
        .to(element, { duration: 0.7, rotationY: 360 }, 0)
        .to(element, { duration: 0.3, x: 100, y: -100, opacity: 0, onComplete: () => element.remove() });
    }

    animatePulse() {
      const cartIcon = document.querySelector('[data-cart-icon]') || document.querySelector('.cart-icon');
      if (!cartIcon) return;

      gsap
        .timeline()
        .to(cartIcon, { duration: 0.3, scale: 1.2 })
        .to(cartIcon, { duration: 0.3, scale: 1 });
    }

    animateSpiral(element) {
      gsap.to(element, {
        duration: 1.2,
        x: 100,
        y: -100,
        rotationZ: 360,
        opacity: 0,
        ease: 'power2.inOut',
        onComplete: () => element.remove(),
      });
    }

    createProductClone(productElement) {
      try {
        const clone = productElement.cloneNode(true);
        clone.style.position = 'fixed';
        clone.style.pointerEvents = 'none';
        clone.style.zIndex = '9999';
        clone.style.width = productElement.offsetWidth + 'px';
        clone.style.height = productElement.offsetHeight + 'px';

        const rect = productElement.getBoundingClientRect();
        clone.style.left = rect.left + 'px';
        clone.style.top = rect.top + 'px';

        document.body.appendChild(clone);
        return clone;
      } catch (error) {
        console.error('[FlyToCartPro] Failed to create product clone:', error);
        return null;
      }
    }

    async playSound(soundType, volume = 0.8) {
      try {
        if (!this.audioContext) {
          const AudioContext = window.AudioContext || window.webkitAudioContext;
          this.audioContext = new AudioContext();
        }

        const buffer = await this.getAudioBuffer(soundType);
        if (!buffer) return;

        const source = this.audioContext.createBufferSource();
        source.buffer = buffer;

        const gainNode = this.audioContext.createGain();
        gainNode.gain.value = Math.min(volume, 1);

        source.connect(gainNode);
        gainNode.connect(this.audioContext.destination);

        source.start(0);
      } catch (error) {
        console.error('[FlyToCartPro] Failed to play sound:', error);
      }
    }

    async getAudioBuffer(soundType) {
      if (this.soundCache.has(soundType)) {
        return this.soundCache.get(soundType);
      }

      try {
        const url = `/sounds/${soundType}.mp3`;
        const response = await fetch(url);
        const arrayBuffer = await response.arrayBuffer();

        const buffer = await this.audioContext.decodeAudioData(arrayBuffer);
        this.soundCache.set(soundType, buffer);
        return buffer;
      } catch (error) {
        console.error(`[FlyToCartPro] Failed to load audio: ${soundType}`, error);
        return null;
      }
    }

    extractProductId(element) {
      return (
        element.dataset.productId ||
        element.dataset.product ||
        element.getAttribute('data-product-id') ||
        ''
      );
    }
  }

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      window.flyToCartPro = new FlyToCartPro();
      console.log('[FlyToCartPro] ✅ Initialized');
    });
  } else {
    window.flyToCartPro = new FlyToCartPro();
    console.log('[FlyToCartPro] ✅ Initialized');
  }
</script>

{% schema %}
{
  "name": "Fly-to-Cart Pro",
  "target": "body",
  "settings": []
}
{% endschema %}
