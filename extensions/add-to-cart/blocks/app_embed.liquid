{% comment %}
  Fly-to-Cart Pro App Embed Block
{% endcomment %}

{% assign ftc_configs_raw = shop.metafields.fly_to_cart.configurations.value %}
{% assign animation_key = '' %}
{% assign sound_key = '' %}
{% if ftc_configs_raw != blank %}
  {% assign ftc_configs = ftc_configs_raw %}
  {% for cfg in ftc_configs %}
    {% if cfg.live == true %}
      {% assign animation_key = cfg.animationKey %}
      {% assign sound_key = cfg.soundKey %}
    {% endif %}
  {% endfor %}
{% endif %}

{% if animation_key != blank or sound_key != blank %}
<script>
(function () {
  var FTC = {
    animationKey: {{ animation_key | default: '' | json }},
    soundKey:     {{ sound_key     | default: '' | json }}
  };

  var audioCtx = null;
  var busy = false; // one animation at a time

  /* ─── Helpers ─────────────────────────────────────────── */

  function ctx() {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    return audioCtx;
  }

  function center(el) {
    var r = el.getBoundingClientRect();
    return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
  }

  function findCart() {
    var tries = [
      '[data-cart-icon-bubble]','[data-cart-toggle]','[data-cart-drawer-trigger]',
      '[data-cart-icon]','.cart-icon','.cart-link','.site-header__cart',
      '[aria-label*="cart" i]','[href="/cart"]','.header__icon--cart',
      '.cart-count-bubble','[data-testid="cart-icon"]'
    ];
    for (var i = 0; i < tries.length; i++) {
      var el = document.querySelector(tries[i]);
      if (el) return el;
    }
    return null;
  }

  /* Creates a small circular "product bubble" that flies to the cart */
  function makeBubble(btn) {
    var container = btn.closest('[data-product], .product, .product-card, .card__inner, form[action*="/cart"]')
                    || btn.parentElement;
    var img = container ? container.querySelector('img[src]') : null;
    var bubble = document.createElement('div');
    var size = 64;

    if (img) {
      bubble.style.cssText = [
        'background-image:url(' + img.src + ')',
        'background-size:cover',
        'background-position:center',
        'border-radius:50%',
        'box-shadow:0 6px 24px rgba(0,0,0,0.35)',
        'border:3px solid #fff'
      ].join(';');
    } else {
      bubble.style.cssText = 'background:#000;border-radius:50%;font-size:26px;display:flex;align-items:center;justify-content:center;color:#fff';
      bubble.textContent = '🛍';
    }

    var from = (img ? img : btn).getBoundingClientRect();
    var cx = from.left + from.width / 2 - size / 2;
    var cy = from.top  + from.height/ 2 - size / 2;

    Object.assign(bubble.style, {
      position: 'fixed',
      left: cx + 'px',
      top:  cy + 'px',
      width:  size + 'px',
      height: size + 'px',
      pointerEvents: 'none',
      zIndex: '99999',
      transformOrigin: 'center center',
    });
    document.body.appendChild(bubble);
    return { el: bubble, cx: cx + size/2, cy: cy + size/2 };
  }

  /* Quadratic bezier arc keyframes from (sx,sy) toward (ex,ey) */
  function arcFrames(sx, sy, ex, ey, extraRotate) {
    var cpx = sx + (ex - sx) * 0.25;
    var cpy = Math.min(sy, ey) - 140;
    var frames = [];
    var N = 16;
    for (var i = 0; i <= N; i++) {
      var t  = i / N;
      var et = t < 0.5 ? 2*t*t : -1+(4-2*t)*t; // ease-in-out
      var bx = (1-et)*(1-et)*sx + 2*(1-et)*et*cpx + et*et*ex;
      var by = (1-et)*(1-et)*sy + 2*(1-et)*et*cpy + et*et*ey;
      var sc = 1 - t * 0.85;
      var op = t > 0.78 ? Math.max(0, 1-(t-0.78)/0.22) : 1;
      var rot= extraRotate ? (t * extraRotate) + 'deg' : '0deg';
      frames.push({
        transform: 'translate('+(bx-sx)+'px,'+(by-sy)+'px) scale('+sc+') rotate('+rot+')',
        opacity: op,
        offset: t
      });
    }
    return frames;
  }

  /* Ripple rings bursting from an element */
  function ripples(el, color) {
    var c = center(el);
    [0, 160, 320].forEach(function(delay) {
      var r = document.createElement('div');
      Object.assign(r.style, {
        position:'fixed', left:c.x+'px', top:c.y+'px',
        width:'8px', height:'8px', borderRadius:'50%',
        border:'2.5px solid '+(color||'#111'),
        transform:'translate(-50%,-50%)',
        pointerEvents:'none', zIndex:'99998'
      });
      document.body.appendChild(r);
      var a = r.animate([
        { width:'8px',  height:'8px',  opacity:0.85 },
        { width:'88px', height:'88px', opacity:0    }
      ], { duration:700, delay:delay, easing:'ease-out', fill:'forwards' });
      a.onfinish = function() { r.remove(); };
    });
  }

  /* Confetti / sparkle burst at (x, y) */
  function sparkles(x, y) {
    var colors = ['#FFD700','#FF6B6B','#4ECDC4','#C084FC','#34D399','#FB923C'];
    for (var i = 0; i < 8; i++) {
      (function(i) {
        var angle = (i / 8) * Math.PI * 2;
        var dist  = 45 + Math.random() * 35;
        var s = document.createElement('div');
        Object.assign(s.style, {
          position:'fixed', left:x+'px', top:y+'px',
          width: (5+Math.random()*5)+'px', height:(5+Math.random()*5)+'px',
          borderRadius:'50%', background:colors[i % colors.length],
          transform:'translate(-50%,-50%)',
          pointerEvents:'none', zIndex:'99998'
        });
        document.body.appendChild(s);
        var a = s.animate([
          { transform:'translate(-50%,-50%) scale(1)',   opacity:1 },
          { transform:'translate(calc(-50% + '+Math.cos(angle)*dist+'px),calc(-50% + '+Math.sin(angle)*dist+'px)) scale(0)', opacity:0 }
        ], { duration:500+Math.random()*300, easing:'ease-out', fill:'forwards' });
        a.onfinish = function() { s.remove(); };
      })(i);
    }
  }

  /* Cart impact: scale + wobble */
  function cartImpact(cart, color) {
    ripples(cart, color);
    var c = center(cart);
    sparkles(c.x, c.y);
    cart.animate([
      { transform:'scale(1) rotate(0deg)' },
      { transform:'scale(1.35) rotate(-8deg)' },
      { transform:'scale(1.1) rotate(5deg)' },
      { transform:'scale(1.2) rotate(-3deg)' },
      { transform:'scale(1) rotate(0deg)' }
    ], { duration:450, easing:'cubic-bezier(0.36,0.07,0.19,0.97)' });
  }

  /* ─── Animations ──────────────────────────────────────── */

  function doSlideIn(btn) {
    var b    = makeBubble(btn);
    var cart = findCart();
    var ex   = cart ? center(cart).x : b.cx + 160;
    var ey   = cart ? center(cart).y : b.cy - 160;

    var a = b.el.animate(arcFrames(b.cx, b.cy, ex, ey, 0), {
      duration: 850, easing: 'linear', fill: 'forwards'
    });
    a.onfinish = function() {
      b.el.remove();
      if (cart) cartImpact(cart, '#111');
    };
  }

  function doBounce(btn) {
    var b    = makeBubble(btn);
    var cart = findCart();
    var ex   = cart ? center(cart).x : b.cx + 160;
    var ey   = cart ? center(cart).y : b.cy - 120;
    var dx   = ex - b.cx;
    var dy   = ey - b.cy;

    // Squash → stretch → 2 bounces → arc to cart (all in one timeline)
    var a = b.el.animate([
      { transform:'translate(0,0) scale(1,1)',       opacity:1, offset:0    },
      { transform:'translate(0,6px) scale(1.25,0.75)', opacity:1, offset:0.06 }, // squash
      { transform:'translate(0,-55px) scale(0.8,1.25)',opacity:1, offset:0.18 }, // stretch up
      { transform:'translate(0,-55px) scale(1,1)',   opacity:1, offset:0.25 },
      { transform:'translate(0,0) scale(1.15,0.85)', opacity:1, offset:0.36 }, // land bounce 1
      { transform:'translate(0,-28px) scale(0.9,1.1)',opacity:1, offset:0.46 },
      { transform:'translate(0,0) scale(1.08,0.92)', opacity:1, offset:0.54 }, // land bounce 2
      { transform:'translate(0,-10px) scale(1,1)',   opacity:1, offset:0.60 },
      { transform:'translate(0,0) scale(1,1)',        opacity:1, offset:0.64 },
      // Arc phase
      { transform:'translate('+(dx*0.3)+'px,'+(dy*0.3-90)+'px) scale(0.75)', opacity:1,   offset:0.77 },
      { transform:'translate('+(dx*0.7)+'px,'+(dy*0.7-40)+'px) scale(0.45)', opacity:0.7, offset:0.90 },
      { transform:'translate('+(dx)+'px,'+(dy)+'px) scale(0.05)',             opacity:0,   offset:1    },
    ], { duration: 1350, easing:'linear', fill:'forwards' });

    a.onfinish = function() {
      b.el.remove();
      if (cart) cartImpact(cart, '#F59E0B');
    };
  }

  function doFlip(btn) {
    var b    = makeBubble(btn);
    var cart = findCart();
    var ex   = cart ? center(cart).x : b.cx + 160;
    var ey   = cart ? center(cart).y : b.cy - 140;
    var dx   = ex - b.cx;
    var dy   = ey - b.cy;

    var a = b.el.animate([
      { transform:'translate(0,0) rotateY(0deg) scale(1)',                         opacity:1,   filter:'blur(0px)', offset:0    },
      { transform:'translate('+(dx*.18)+'px,'+(dy*.15)+'px) rotateY(180deg) scale(0.95)', opacity:1,   filter:'blur(3px)', offset:0.22 },
      { transform:'translate('+(dx*.38)+'px,'+(dy*.30)+'px) rotateY(360deg) scale(0.85)', opacity:1,   filter:'blur(0px)', offset:0.44 },
      { transform:'translate('+(dx*.60)+'px,'+(dy*.50)+'px) rotateY(540deg) scale(0.65)', opacity:0.9, filter:'blur(3px)', offset:0.66 },
      { transform:'translate('+(dx*.82)+'px,'+(dy*.72)+'px) rotateY(680deg) scale(0.35)', opacity:0.5, filter:'blur(1px)', offset:0.85 },
      { transform:'translate('+(dx)+'px,'+(dy)+'px) rotateY(720deg) scale(0.05)',         opacity:0,   filter:'blur(4px)', offset:1    },
    ], { duration: 1050, easing:'cubic-bezier(0.42,0,0.58,1)', fill:'forwards' });

    a.onfinish = function() {
      b.el.remove();
      if (cart) cartImpact(cart, '#6366F1');
    };
  }

  function doPulse(btn) {
    var cart = findCart();
    if (!cart) return;
    var c = center(cart);

    // Heartbeat double-pump on cart
    cart.animate([
      { transform:'scale(1)',    offset:0    },
      { transform:'scale(1.35)', offset:0.14 },
      { transform:'scale(1.15)', offset:0.28 },
      { transform:'scale(1.3)',  offset:0.42 },
      { transform:'scale(1)',    offset:0.60 },
      { transform:'scale(1)',    offset:1    },
    ], { duration:700, easing:'ease-in-out' });

    // 4 expanding colored rings
    ['#111','#6366F1','#F59E0B','#34D399'].forEach(function(color, i) {
      var ring = document.createElement('div');
      Object.assign(ring.style, {
        position:'fixed', left:c.x+'px', top:c.y+'px',
        width:'10px', height:'10px', borderRadius:'50%',
        border:'3px solid '+color,
        transform:'translate(-50%,-50%)',
        pointerEvents:'none', zIndex:'99998'
      });
      document.body.appendChild(ring);
      var ra = ring.animate([
        { width:'10px',  height:'10px',  opacity:0.9 },
        { width:'100px', height:'100px', opacity:0   }
      ], { duration:900, delay:i*120, easing:'ease-out', fill:'forwards' });
      ra.onfinish = function() { ring.remove(); };
    });

    sparkles(c.x, c.y);
  }

  function doSpiral(btn) {
    var b    = makeBubble(btn);
    var cart = findCart();
    var ex   = cart ? center(cart).x : b.cx + 100;
    var ey   = cart ? center(cart).y : b.cy - 100;

    // Tightening spiral keyframes
    var frames = [];
    var N = 22, turns = 2.8;
    for (var i = 0; i <= N; i++) {
      var t  = i / N;
      var ang = t * turns * Math.PI * 2;
      var r  = (1 - t) * 85;
      var tx = (ex - b.cx) + Math.cos(ang) * r;
      var ty = (ey - b.cy) + Math.sin(ang) * r;
      var sc = 1 - t * 0.88;
      var op = t > 0.75 ? Math.max(0, 1-(t-0.75)/0.25) : 1;
      frames.push({
        transform:'translate('+tx+'px,'+ty+'px) rotate('+(t*turns*360)+'deg) scale('+sc+')',
        opacity: op,
        offset: t
      });
    }

    var a = b.el.animate(frames, { duration:1300, easing:'ease-in', fill:'forwards' });

    // Particle trail following the bubble
    var trailId = setInterval(function() {
      var pos = b.el.getBoundingClientRect();
      if (!pos.width) { clearInterval(trailId); return; }
      var dot = document.createElement('div');
      Object.assign(dot.style, {
        position:'fixed',
        left:(pos.left + pos.width/2)+'px',
        top: (pos.top  + pos.height/2)+'px',
        width:'7px', height:'7px', borderRadius:'50%',
        background:'rgba(139,92,246,0.55)',
        transform:'translate(-50%,-50%)',
        pointerEvents:'none', zIndex:'99997'
      });
      document.body.appendChild(dot);
      var da = dot.animate([
        { opacity:0.8, transform:'translate(-50%,-50%) scale(1)' },
        { opacity:0,   transform:'translate(-50%,-50%) scale(0.15)' }
      ], { duration:450, easing:'ease-out', fill:'forwards' });
      da.onfinish = function() { dot.remove(); };
    }, 55);

    a.onfinish = function() {
      clearInterval(trailId);
      b.el.remove();
      if (cart) cartImpact(cart, '#8B5CF6');
    };
  }

  function playAnimation(btn) {
    var map = {
      slide_in: doSlideIn,
      bounce:   doBounce,
      flip:     doFlip,
      pulse:    doPulse,
      spiral:   doSpiral,
    };
    var fn = map[FTC.animationKey];
    if (fn) fn(btn);
  }

  /* ─── Sounds ──────────────────────────────────────────── */

  function playSound(key) {
    try {
      var c = ctx(), t = c.currentTime;
      ({
        chime:   function() { [523,659,784,1047].forEach(function(f,i){ var o=c.createOscillator(),g=c.createGain(); o.type='sine'; o.connect(g); g.connect(c.destination); o.frequency.value=f; g.gain.setValueAtTime(0.28,t+i*0.1); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.1+0.35); o.start(t+i*0.1); o.stop(t+i*0.1+0.35); }); },
        whoosh:  function() { var o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter(); o.type='sawtooth'; f.type='bandpass'; f.frequency.value=800; o.connect(f); f.connect(g); g.connect(c.destination); o.frequency.setValueAtTime(600,t); o.frequency.exponentialRampToValueAtTime(80,t+0.55); g.gain.setValueAtTime(0.25,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.55); o.start(t); o.stop(t+0.55); },
        pop:     function() { var o=c.createOscillator(),g=c.createGain(); o.type='sine'; o.connect(g); g.connect(c.destination); o.frequency.setValueAtTime(220,t); o.frequency.exponentialRampToValueAtTime(55,t+0.12); g.gain.setValueAtTime(0.45,t); g.gain.exponentialRampToValueAtTime(0.001,t+0.12); o.start(t); o.stop(t+0.12); },
        bell:    function() { [800,1600].forEach(function(f,i){ var o=c.createOscillator(),g=c.createGain(); o.type='sine'; o.connect(g); g.connect(c.destination); o.frequency.value=f; g.gain.setValueAtTime(0.22,t+i*0.05); g.gain.exponentialRampToValueAtTime(0.001,t+0.9); o.start(t+i*0.05); o.stop(t+0.9); }); },
        sparkle: function() { [0,1,2,3].forEach(function(i){ var o=c.createOscillator(),g=c.createGain(); o.type='triangle'; o.connect(g); g.connect(c.destination); o.frequency.value=900+i*350; g.gain.setValueAtTime(0.18,t+i*0.12); g.gain.exponentialRampToValueAtTime(0.001,t+i*0.12+0.2); o.start(t+i*0.12); o.stop(t+i*0.12+0.2); }); },
      })[key]();
    } catch(e) {}
  }

  /* ─── Click listener ──────────────────────────────────── */

  document.addEventListener('click', function(e) {
    if (busy) return;
    var btn = e.target.closest('[data-add-to-cart],[name="add"],button[type="submit"],[data-cart-add]');
    if (!btn) return;
    var txt = (btn.textContent || btn.value || '').trim();
    var isCartBtn = /add.to.(cart|bag)|add.to.bag/i.test(txt)
                 || btn.hasAttribute('data-add-to-cart')
                 || btn.getAttribute('name') === 'add';
    if (!isCartBtn) return;

    busy = true;
    setTimeout(function() { busy = false; }, 1400);

    if (FTC.animationKey) playAnimation(btn);
    if (FTC.soundKey)     playSound(FTC.soundKey);
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Fly-to-Cart Pro",
  "target": "body",
  "settings": []
}
{% endschema %}
